{
  "manifestVersion": 5,
  "id": "com.ogtools.personal.premiere",
  "name": "OG Tools Personal",
  "version": "0.8.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ogtools.panel",
      "label": {
        "default": "OG Tools"
      },
      "minimumSize": {
        "width": 320,
        "height": 430
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8734",
        "http://localhost:8734"
      ]
    },
    "localFileSystem": "request"
  }
}
